# â”€â”€â”€ SafeSense AI Backend Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# â”€â”€â”€ Translation Provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Controls which translation engine is used for multilingual report processing.
#
# Options:
#   auto          â†’ Try deep-translator (Google) first, fall back to offline dict
#   deep_translator â†’ Use deep-translator (requires internet access)
#   offline       â†’ Use built-in safety-domain dictionary only (no internet needed)
#
# For production/air-gapped environments, set to "offline" or replace with
# IndicTrans2 integration.
TRANSLATION_PROVIDER=auto

# â”€â”€â”€ Optional: Explicit translation API key â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Only required if you switch to a paid translation service.
# deep-translator's Google backend does NOT require a key for basic use.
# TRANSLATION_API_KEY=your_key_here

# â”€â”€â”€ JWT Secret Key â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Change this to a long random string in production.
JWT_SECRET_KEY=safesense-ai-change-this-in-production

# ===== Authentication (product pass) =====
# Access-token lifetime in minutes (default 480 = 8 hours).
# AUTH_TOKEN_EXPIRE_MINUTES=480
#
# Password reset: in production configure an SMTP provider (SendGrid, SES, or
# any SMTP relay) so reset links can be emailed to users.
# When SMTP is NOT configured and SAFESENSE_DEV_EXPOSE_RESET_TOKEN=1, the
# forgot-password response returns a dev_reset_token in the API response for
# local development ONLY. NEVER enable this in production.
# SAFESENSE_DEV_EXPOSE_RESET_TOKEN=0
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# â”€â”€â”€ CORS Origins â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# â”€â”€â”€ Groq Safety Copilot â””€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required for Safety Copilot AI reasoning (/api/copilot/chat and
# /api/copilot/chat/stream). Get your API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Phase 5: ML-Assisted Semantic Layer
# Advisory semantic layer (TF-IDF over a curated concept bank, scikit-learn only,
# no model artifacts, no network). Set to "off" to force deterministic-only mode.
# SAFESENSE_SEMANTIC_ML=on

# ===== Database (Phase 6 Batch 1) =====
# DATABASE_URL selects the persistence backend. SQLite remains the DEFAULT
# local/demo database (zero setup); PostgreSQL is used only when DATABASE_URL
# is explicitly configured.
#
# Default (unset/empty) - SQLite file database at backend/safety.db:
#   DATABASE_URL=sqlite:///backend/safety.db
#
# PostgreSQL (canonical form; requires psycopg driver, schema via Alembic):
#   DATABASE_URL=postgresql+psycopg://safesense:safesense@localhost:5432/safesense
#
# Notes:
# - Always use the postgresql+psycopg:// dialect prefix for PostgreSQL.
# - SQLite mode bootstraps its schema automatically (create_all + legacy ensure
#   migrations + demo seed). PostgreSQL schema is managed exclusively by Alembic:
#   cd backend && alembic upgrade head
# DATABASE_URL=
