# â”€â”€â”€ SafeSense AI Backend Configuration â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copy this file to .env and fill in values for your environment.
# Never commit .env to version control.

# â”€â”€â”€ Translation Provider â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Controls which translation engine is used for multilingual report processing.
#
# Options:
#   auto          â†’ Try deep-translator (Google) first, fall back to offline dict
#   deep_translator â†’ Use deep-translator (requires internet access)
#   offline       â†’ Use built-in safety-domain dictionary only (no internet needed)
#
# For production/air-gapped environments, set to "offline" or replace with
# IndicTrans2 integration.
TRANSLATION_PROVIDER=auto

# â”€â”€â”€ Optional: Explicit translation API key â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Only required if you switch to a paid translation service.
# deep-translator's Google backend does NOT require a key for basic use.
# TRANSLATION_API_KEY=your_key_here

# â”€â”€â”€ JWT Secret Key â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Change this to a long random string in production.
JWT_SECRET_KEY=safesense-ai-change-this-in-production

# â”€â”€â”€ CORS Origins â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# â”€â”€â”€ Groq Safety Copilot â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Required for Safety Copilot AI reasoning (/api/copilot/chat).
# Get your API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Phase 5: ML-Assisted Semantic Layer
# Advisory semantic layer (TF-IDF over a curated concept bank, scikit-learn only,
# no model artifacts, no network). Set to "off" to force deterministic-only mode.
# SAFESENSE_SEMANTIC_ML=on
